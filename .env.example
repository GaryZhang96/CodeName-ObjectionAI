# ============================================================
# Lex Machina 环境变量模板
#
# 用法：
#   1. 复制为 .env：cp .env.example .env
#   2. 填入真实的 API Key
#   3. .env 已被 git 忽略，不会上传
#
# 安全说明：
#   变量名没有 VITE_ 前缀 → 只能在 Node 服务端读到
#   绝对不会被打包到前端 JS 里，浏览器看不到。
# ============================================================

# OpenRouter API Key（必填）
# 申请：https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 服务端端口（开发用，生产环境 Render 会自动覆盖）
PORT=3000

# 公开访问 URL（OpenRouter 统计用，可选）
PUBLIC_URL=http://localhost:5173
